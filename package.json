{
  "name": "git-user-mapper",
  "version": "1.0.0",
  "description": "Map directories to git identities and show the active profile in your shell prompt",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "git-mapper": "dist/bin/index.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --check-coverage --lines 80 node --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soohanpark/git-user-mapper.git"
  },
  "keywords": [
    "git",
    "git-config",
    "identity",
    "profile",
    "includeif",
    "monorepo"
  ],
  "author": "Soohan Park <725psh@gmail.com> (https://github.com/soohanpark)",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "execa": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.20.1",
    "c8": "^10.1.3",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/soohanpark/git-user-mapper/issues"
  },
  "homepage": "https://github.com/soohanpark/git-user-mapper#readme"
}
